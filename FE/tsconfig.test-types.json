{
  "extends": "./tsconfig.jest.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest", "node", "vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "test"]
}
